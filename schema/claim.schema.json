{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nanocubit/TAHI/schema/claim.schema.json",
  "title": "Archivarius Claim",
  "type": "object",
  "required": ["id", "subject", "predicate", "object", "provenance"],
  "properties": {
    "id": {"type": "string"},
    "subject": {"type": "string"},
    "predicate": {"type": "string"},
    "object": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["extracted", "inferred", "verified", "contradicted"]},
    "provenance": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string"},
        "source_version": {"type": ["string", "null"]},
        "extractor": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
